---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
---
<Base title={p.data.title} description={p.data.summary}>
  <main class="detail">
    <a class="back" href="/#work">← Work</a>
    <h1>{p.data.title}</h1>
    <div class="meta">{p.data.period} · {p.data.status}{p.data.site && <> · <a href={p.data.site}>{new URL(p.data.site).host}</a></>}{p.data.repo && <> · <a href={p.data.repo}>source on GitHub</a></>}</div>
    <div class="chips" style="margin-bottom:2.5rem">{p.data.stack?.map((s) => <span class="chip">{s}</span>)}</div>
    <div class="prose"><Content /></div>
  </main>
</Base>
