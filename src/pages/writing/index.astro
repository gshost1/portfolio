---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('writing')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title="Writing">
  <h1>Writing</h1>
  <ul class="list">
    {posts.map((w) => (
      <li>
        <a class="title" href={`/writing/${w.id}/`}>{w.data.title}</a>
        <div class="sub">{w.data.summary}</div>
        <div class="sub muted">{fmt(w.data.date)}</div>
      </li>
    ))}
  </ul>
</Base>
