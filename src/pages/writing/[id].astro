---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map((w) => ({ params: { id: w.id }, props: { w } }));
}
const { w } = Astro.props;
const { Content } = await render(w);
const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={w.data.title} description={w.data.summary}>
  <main class="detail">
    <a class="back" href="/#writing">← Writing</a>
    <h1>{w.data.title}</h1>
    <div class="meta">{fmt(w.data.date)}</div>
    <div class="prose"><Content /></div>
  </main>
</Base>
