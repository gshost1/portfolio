---
import '../styles/global.css';
const { title, description = 'Georgiy Shostakovich. Founder. Built and shipped Rowanstead solo through a fleet of coding agents.' } = Astro.props;
const pageTitle = title ? `${title} · Georgiy Shostakovich` : 'Georgiy Shostakovich';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="alternate" type="application/rss+xml" title="Writing" href="/rss.xml" />
  </head>
  <body>
    <slot />
  </body>
</html>
